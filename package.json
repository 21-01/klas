{
  "name": "klas-frontend",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "dev:tunnel": "react-router dev --host",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:probe": "node scripts/db.mjs probe",
    "db:schema": "node scripts/db.mjs file supabase/migrations/001_core.sql && node scripts/db.mjs file supabase/migrations/002_academic.sql && node scripts/db.mjs file supabase/migrations/003_attendance.sql && node scripts/db.mjs file supabase/migrations/004_security.sql && node scripts/db.mjs file neon/sql/001_functions.sql",
    "db:auth-users": "node scripts/auth-users.mjs",
    "db:seed": "node scripts/seed.mjs",
    "db:setup": "pnpm db:schema && pnpm db:auth-users && pnpm db:seed",
    "neon:deploy": "neon deploy --env .env.local",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@neon/auth": "^0.8.2",
    "@neon/config": "^1.14.0",
    "@neon/env": "^2.1.3",
    "@neon/functions": "^0.11.0",
    "@neon/realtime": "^0.2.1",
    "@neon/realtime-react": "^0.2.0",
    "@react-router/node": "8.0.0",
    "@react-router/serve": "8.0.0",
    "@yudiel/react-qr-scanner": "^2.6.0",
    "clsx": "^2.1.1",
    "hono": "^4.13.18",
    "isbot": "^5.1.36",
    "jose": "^6.2.17",
    "lucide-react": "^1.21.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-qr-code": "^2.2.0",
    "react-router": "8.0.0",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@react-router/dev": "8.0.0",
    "@tailwindcss/vite": "^4.2.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "happy-dom": "^20.10.6",
    "pg": "^8.23.1",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3",
    "vite": "^8.0.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.9"
  }
}

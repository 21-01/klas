# ── Neon Auth (browser) ──────────────────────────────────
VITE_NEON_AUTH_URL=https://<endpoint>.neonauth.<cell>.<region>.aws.neon.tech/neondb/auth
VITE_NEON_API_URL=https://<branch-id>-api.compute.<cell>.<region>.aws.neon.tech
VITE_NEON_REALTIME_URL=wss://<realtime-endpoint>

# ── Neon branch (server / scripts) ───────────────────────
# `neon env pull` writes these into .env.local; commit nothing here.
DATABASE_URL=postgresql://...
DATABASE_URL_UNPOOLED=postgresql://...
NEON_BRANCH=production
NEON_BRANCH_ID=br-...
NEON_AUTH_BASE_URL=https://<endpoint>.neonauth.<cell>.<region>.aws.neon.tech/neondb/auth
NEON_AUTH_JWKS_URL=https://<endpoint>.neonauth.<cell>.<region>.aws.neon.tech/neondb/auth/.well-known/jwks.json
NEON_FUNCTION_HOST_SUFFIX=.compute.<cell>.<region>.aws.neon.tech
NEON_REALTIME_URL=wss://...
NEON_REALTIME_SECRET=...
AWS_ACCESS_KEY_ID=...
AWS_SECRET_ACCESS_KEY=...
AWS_ENDPOINT_URL_S3=...
AWS_REGION=ap-southeast-1

# ── Function secrets (declared in neon.ts) ───────────────
QR_SECRET=change-me-at-least-32-characters-long
KLAS_CORS_ORIGINS=http://localhost:5173
KLAS_REPORT_BUCKET=assets
